    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Copilot Chat calls provideLanguageModelChatResponse",
        "Messages are converted to the OpenAI-compatible request format",
        "api.ts handles retries, timeouts, and SSE assembly"
      ]
    },
    {
      "dot": "emerald",
      "title": "Model discovery",
      "items": [
        "GET /models is normalized into capability-aware entries",
        "globalState caches normalized models and the cache version",
        "The model picker receives selectable chat metadata"
      ]
    },
    {
      "dot": "rose",
      "title": "Tools and resilience",
      "items": [
        "Native and text-embedded tool calls are repaired and deduplicated",
        "Non-vision models use a cached vision model or image-analysis tool",
        "Silent retries cover rate limits, stalls, truncation, and missing tool calls"
      ]
    }
