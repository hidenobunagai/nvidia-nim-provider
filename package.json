{
  "name": "nvidia-nim-provider",
  "publisher": "HidenobuNagai",
  "displayName": "NVIDIA NIM Provider",
  "description": "Use NVIDIA NIM models in GitHub Copilot Chat for VS Code",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hidenobunagai/nvidia-nim-provider"
  },
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1A1A2E",
    "theme": "dark"
  },
  "keywords": [
    "copilot",
    "copilot-chat",
    "nvidia",
    "nim",
    "chat",
    "vscode",
    "ai",
    "llm",
    "models"
  ],
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onLanguageModelChatProvider:nvidia-nim"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "nvidia-nim",
        "displayName": "NVIDIA NIM",
        "configuration": {
          "properties": {
            "apiKey": {
              "type": "string",
              "secret": true,
              "description": "API key from build.nvidia.com/models",
              "title": "API Key"
            }
          },
          "required": [
            "apiKey"
          ]
        }
      }
    ],
    "languageModelTools": [
      {
        "name": "nvidia_nim_analyze_image",
        "toolReferenceName": "analyzeImage",
        "displayName": "NVIDIA NIM Analyze Image",
        "modelDescription": "Analyze an image with the NVIDIA NIM vision model and return a text description.",
        "userDescription": "Analyze an image using NVIDIA NIM Vision.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "image_data": {
              "type": "string",
              "description": "Base64-encoded image data URL."
            },
            "prompt": {
              "type": "string",
              "description": "Instruction describing what to analyze in the image."
            }
          },
          "required": [
            "image_data",
            "prompt"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "nvidia-nim.manage",
        "title": "Manage NVIDIA NIM API Key",
        "category": "NVIDIA NIM"
      },
      {
        "command": "nvidia-nim.refreshModels",
        "title": "Refresh Models",
        "category": "NVIDIA NIM"
      },
      {
        "command": "nvidia-nim.toggleDebugLogging",
        "title": "Toggle Debug Logging",
        "category": "NVIDIA NIM"
      },
      {
        "command": "nvidia-nim.openDebugLog",
        "title": "Open Debug Log",
        "category": "NVIDIA NIM"
      },
      {
        "command": "nvidia-nim.toggleShowReasoning",
        "title": "Toggle Reasoning Content Display",
        "category": "NVIDIA NIM"
      }
    ],
    "configuration": {
      "title": "NVIDIA NIM",
      "properties": {
        "nvidia-nim.showReasoning": {
          "type": "boolean",
          "default": false,
          "description": "Show model reasoning content (thinking process) in responses. Some models like DeepSeek R1 emit reasoning that may be useful for debugging."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "package:vsix": "bun run compile && vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.9.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^29.0.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.58.2"
  },
  "dependencies": {
    "jsonrepair": "^3.14.0"
  }
}
